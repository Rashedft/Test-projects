config_version=5

[application]
config/name="Poke Journey"
config/version="0.1"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Three Regions — Development Build 0.1"
config/custom_user_dir_name.windows="Godot/app_userdata/Three Regions — Development Build 0.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
Game="*res://scripts/game.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.48,0.72,0.87,1)
